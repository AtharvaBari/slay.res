# ------------------------------------------------------------------ #
#  AI engine (all optional). Engine selection, first available wins:
#    Gemini (GEMINI_API_KEY) -> Claude (ANTHROPIC_API_KEY) -> deterministic.
#  With no keys set, Slay.res runs a fully deterministic keyword engine —
#  no external calls, no hallucinations. Every path is held to the same
#  zero-hallucination traceability guarantee.
# ------------------------------------------------------------------ #

# Google Gemini (primary LLM path). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (defaults to gemini-2.5-flash).
SLAY_GEMINI_MODEL=gemini-flash-latest

# Anthropic Claude (optional fallback LLM path).
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5).
SLAY_MODEL=claude-opus-5

# ------------------------------------------------------------------ #
#  Auth + local database (optional). Sign in with Google to auto-save
#  your details to a local SQLite file (slay.db). Signed out, the app
#  still works fully in-memory.
# ------------------------------------------------------------------ #

# Where the SQLite file lives (defaults to ./slay.db).
# SLAY_DB_PATH=

# NextAuth. NEXTAUTH_URL is your app's base URL; generate a secret with:
#   openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
#   1. Create an "OAuth client ID" of type "Web application".
#   2. Add Authorized redirect URI:  http://localhost:3000/api/auth/callback/google
#   3. Paste the client id / secret below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
